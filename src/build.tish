// spacedevin.github.io — the index page.
//
// Written in Tish (https://tishlang.com) and run by the Tish runtime, not compiled to JS: the build
// needs both `fetch` and a filesystem, and `tish:fs` is only available under `tish run`. Hence
// `tish run --feature full src/build.tish`.
//
// The list comes from the PROFILE README (github.com/spacedevin/spacedevin), not from pinned repos:
// GitHub caps pins at six, and the profile page has no limit and keeps its own order. The README is
// the one place the list is edited; a push there dispatches a rebuild here.
//
// Only selection and order are manual. Descriptions, homepages and languages are read from the repos
// themselves at build time, so they stay current without anyone editing this list — unless a line
// carries an explicit description override.
//
// Everything is baked into static HTML: the page ships as one file with no client-side JavaScript
// and nothing to rate-limit.

import { writeFile, mkdir, readFile } from "tish:fs"

let USER = "spacedevin"
let OUT = "dist"
// The profile repo — `owner/owner` is GitHub's convention for the profile README.
let PROFILE_REPO = "spacedevin"

// ── data ──────────────────────────────────────────────────────────────────────

let PROFILE_QUERY = "query($login:String!,$repo:String!){user(login:$login){name login bio} " +
  "repository(owner:$login,name:$repo){object(expression:\"HEAD:README.md\"){... on Blob{text}}}}"

// One line per repo: `- [label](https://github.com/owner/repo)` with an optional `— description`.
let LINE = /^\s*-\s*\[([^\]]+)\]\(https:\/\/github\.com\/([^\/\)]+)\/([^\/\)\s#]+)\/?\)\s*(?:[—–-]\s*(.*))?$/

// Per-repo fields. The tree lookups are for language detection — see `language()`.
let REPO_FIELDS = "nameWithOwner name description url homepageUrl isArchived " +
  "primaryLanguage{name color} " +
  "root: object(expression:\"HEAD:\"){... on Tree{entries{name}}} " +
  "src: object(expression:\"HEAD:src\"){... on Tree{entries{name}}} " +
  "pkgs: object(expression:\"HEAD:packages\"){... on Tree{entries{name}}}"

// tishlang.com's own accent (`--theme-accent` in its globals.css).
let TISH_COLOR = "oklch(0.72 0.18 5)"

async fn graphql(query, variables) {
  // GitHub's GraphQL API requires a token even for public data. Actions supplies GITHUB_TOKEN; for a
  // local build, pass one in (`GITHUB_TOKEN=$(gh auth token) npm run build`).
  let token = process.env.GITHUB_TOKEN
  if (!token) {
    throw new Error("GITHUB_TOKEN is required — GitHub's GraphQL API rejects anonymous requests.\n" +
      "  local: GITHUB_TOKEN=$(gh auth token) npm run build")
  }
  let res = await fetch("https://api.github.com/graphql", {
    method: "POST",
    headers: {
      // GitHub rejects requests without one.
      "User-Agent": USER + ".github.io build",
      "Authorization": "bearer " + token,
      "Content-Type": "application/json"
    },
    body: JSON.stringify({ query: query, variables: variables })
  })
  if (!res.ok) {
    throw new Error("GitHub API " + res.status + " " + res.statusText)
  }
  let body = await res.json()
  // GraphQL reports a missing repo as an error AND still returns data with that alias null. Only a
  // total failure should stop the build — otherwise one bad line in the list takes the site down,
  // and `fetchRepos` can never reach the code that skips it.
  if (!body.data) {
    throw new Error("GraphQL: " + JSON.stringify(body.errors))
  }
  return body.data
}

/// Pull `owner/repo` (and any description override) out of the profile README, in order.
fn parseList(markdown) {
  let out = []
  // Drop HTML comments first: the README documents its own format inside one, and those example
  // lines are otherwise indistinguishable from real entries.
  let lines = markdown.replace(/<!--[\s\S]*?-->/g, "").split("\n")
  let i = 0
  while (i < lines.length) {
    let m = LINE.exec(lines[i])
    if (m) {
      out.push({ label: m[1], owner: m[2], repo: m[3], description: m[4] ? m[4].trim() : null })
    }
    i = i + 1
  }
  return out
}

/**
 * One aliased query for every listed repo, so the whole page costs two requests regardless of how
 * long the list grows. Aliases are positional (`r0`, `r1`, …) because a repo name is not a legal
 * GraphQL alias — `juke.sh` and `hypery-sdk` both have characters an alias can't carry.
 */
async fn fetchRepos(entries) {
  if (entries.length === 0) {
    return []
  }
  let parts = []
  let vars = {}
  let i = 0
  while (i < entries.length) {
    parts.push("r" + i + ": repository(owner:$o" + i + ",name:$n" + i + "){" + REPO_FIELDS + "}")
    vars["o" + i] = entries[i].owner
    vars["n" + i] = entries[i].repo
    i = i + 1
  }
  let decls = []
  let d = 0
  while (d < entries.length) {
    decls.push("$o" + d + ":String!,$n" + d + ":String!")
    d = d + 1
  }
  let data = await graphql("query(" + decls.join(",") + "){" + parts.join(" ") + "}", vars)

  let repos = []
  let k = 0
  while (k < entries.length) {
    let r = data["r" + k]
    if (!r) {
      // A typo or a repo that went private shouldn't take the whole build down — say so and skip.
      console.log("  ! skipping " + entries[k].owner + "/" + entries[k].repo + " — not found or not visible")
    } else {
      // A description written in the README wins; otherwise the repo's own, so it stays current.
      if (entries[k].description) {
        r.description = entries[k].description
      }
      r.label = entries[k].label
      repos.push(r)
    }
    k = k + 1
  }
  return repos
}

// ── html ──────────────────────────────────────────────────────────────────────

fn esc(s) {
  // `null` only — the Tish runtime has no `undefined` binding at all (referencing it is an
  // "Undefined variable" error), and a missing property reads as null.
  if (s === null) {
    return ""
  }
  return String(s)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
}

/// `https://tishlang.com/` → `tishlang.com`. The scheme is noise in a list this dense.
fn prettyUrl(u) {
  return String(u).replace(/^https?:\/\//, "").replace(/\/$/, "")
}

fn pad(n) {
  let s = String(n)
  while (s.length < 3) {
    s = "0" + s
  }
  return s
}

fn countTish(tree) {
  if (!tree) {
    return 0
  }
  let entries = tree.entries
  if (!entries) {
    return 0
  }
  let n = 0
  let i = 0
  while (i < entries.length) {
    if (entries[i].name.endsWith(".tish")) {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

/**
 * GitHub reports the language via Linguist, which has no `.tish` support — so a repo written in Tish
 * is labelled by whatever incidental JS or TS it also contains. `deck` reads as JavaScript off its
 * build output; `lattish`, a Tish framework, reads as JavaScript too.
 *
 * Rather than hard-code a list of names that goes stale, detect it: a repo whose SOURCE directories
 * hold `.tish` files is a Tish repo. Source dirs specifically, not the root — `tishlang/tish` is the
 * compiler, written in Rust, and happens to keep one `.tish` example at its root. A root-heavy
 * layout still qualifies at 3+, which is how `deckard` is caught.
 *
 * Delete all of this when Linguist learns the extension. It is not close yet: the bar is 2000
 * indexed files excluding the language owner, and third-party usage sits near 500.
 */
fn language(repo) {
  let src = countTish(repo.src)
  let pkgs = countTish(repo.pkgs)
  let root = countTish(repo.root)
  if (src > 0 || pkgs > 0 || root >= 3) {
    return { name: "Tish", color: TISH_COLOR }
  }
  return repo.primaryLanguage
}

fn repoRow(repo, index) {
  let lang = language(repo)
  let out = []
  out.push("<li class=\"repo\">")
  out.push("<span class=\"n\">" + pad(index + 1) + "</span>")
  out.push("<div class=\"body\">")

  out.push("<div class=\"head\">")
  out.push("<a class=\"name\" href=\"" + esc(repo.url) + "\">" + esc(repo.label ? repo.label : repo.name) + "</a>")
  if (repo.isArchived) {
    out.push("<span class=\"tag\">archived</span>")
  }
  out.push("<span class=\"spacer\"></span>")
  if (lang) {
    // Dot AFTER the label: the row is right-aligned, so a leading dot sits at a different x on every
    // row (the labels differ in length). Trailing, the dots line up on the right edge.
    //
    // GitHub's own language colour, carried through from the API — except Tish, which has no
    // Linguist entry to carry a colour from, so it uses tishlang.com's accent.
    out.push("<span class=\"lang\">" + esc(lang.name) + "<i style=\"background:" + esc(lang.color) + "\"></i></span>")
  }
  out.push("</div>")

  if (repo.description) {
    out.push("<p class=\"desc\">" + esc(repo.description) + "</p>")
  }
  if (repo.homepageUrl) {
    out.push("<a class=\"home\" href=\"" + esc(repo.homepageUrl) + "\">" + esc(prettyUrl(repo.homepageUrl)) + "</a>")
  }

  out.push("</div>")
  out.push("</li>")
  return out.join("")
}

fn page(user, repos) {
  let rows = []
  let i = 0
  while (i < repos.length) {
    rows.push(repoRow(repos[i], i))
    i = i + 1
  }

  let name = user.name ? user.name : user.login
  let bio = user.bio ? user.bio : ""

  return "<!doctype html>\n" +
    "<html lang=\"en\">\n" +
    "<head>\n" +
    "<meta charset=\"utf-8\">\n" +
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n" +
    "<title>" + esc(name) + "</title>\n" +
    "<meta name=\"description\" content=\"" + esc(bio) + " — projects by " + esc(user.login) + ".\">\n" +
    "<meta property=\"og:title\" content=\"" + esc(name) + "\">\n" +
    "<meta property=\"og:description\" content=\"" + esc(bio) + "\">\n" +
    "<meta name=\"color-scheme\" content=\"dark light\">\n" +
    "<link rel=\"stylesheet\" href=\"style.css\">\n" +
    "<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ctext y='13' font-size='14'%3E%E2%97%86%3C/text%3E%3C/svg%3E\">\n" +
    "</head>\n" +
    "<body>\n" +
    "<main>\n" +
    "<header>\n" +
    "<h1>" + esc(name) + "</h1>\n" +
    "<p class=\"bio\">" + esc(bio) + "</p>\n" +
    "</header>\n" +
    "<h2>projects</h2>\n" +
    "<ol class=\"repos\">\n" + rows.join("\n") + "\n</ol>\n" +
    "<footer>\n" +
    "<a href=\"https://github.com/" + esc(user.login) + "\">github.com/" + esc(user.login) + "</a>\n" +
    "<span class=\"sep\">·</span>\n" +
    "<span>built with <a href=\"https://tishlang.com\">tish</a></span>\n" +
    "</footer>\n" +
    "</main>\n" +
    "</body>\n" +
    "</html>\n"
}

// ── build ─────────────────────────────────────────────────────────────────────

let profile = await graphql(PROFILE_QUERY, { login: USER, repo: PROFILE_REPO })
let readme = profile.repository ? profile.repository.object : null
if (!readme) {
  throw new Error("no README.md in " + USER + "/" + PROFILE_REPO + " — that file is the project list")
}
let entries = parseList(readme.text)
if (entries.length === 0) {
  throw new Error("no `- [label](https://github.com/owner/repo)` lines found in the profile README")
}
let user = profile.user
let repos = await fetchRepos(entries)

mkdir(OUT)
writeFile(OUT + "/index.html", page(user, repos))
writeFile(OUT + "/style.css", readFile("src/style.css"))

// GitHub Pages otherwise runs Jekyll over the artifact, which eats files starting with an underscore.
writeFile(OUT + "/.nojekyll", "")

console.log("built " + OUT + "/index.html — " + repos.length + " repos from " + USER + "/" + PROFILE_REPO + "/README.md")
let i = 0
while (i < repos.length) {
  let r = repos[i]
  let l = language(r)
  console.log("  " + pad(i + 1) + "  " + (r.label ? r.label : r.name) + (l ? "  [" + l.name + "]" : "") +
    (l && r.primaryLanguage && l.name !== r.primaryLanguage.name ? "  (github says " + r.primaryLanguage.name + ")" : ""))
  i = i + 1
}
